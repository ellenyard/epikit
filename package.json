    "test:histogram": "node scripts/histogramBins.regression.mjs",
    "test:record-filter": "node scripts/recordFilter.regression.mjs && TZ=Asia/Kolkata node scripts/recordFilter.regression.mjs && TZ=Pacific/Auckland node scripts/recordFilter.regression.mjs && TZ=America/New_York node scripts/recordFilter.regression.mjs",
